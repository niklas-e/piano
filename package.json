{
  "name": "piano-practice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check --write",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:offline",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.ts",
    "generate-pwa-assets": "pwa-assets-generator",
    "test:offline": "playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/webcomponents": "2.1.5",
    "abcjs": "6.7.2",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vite-pwa/assets-generator": "2.0.0",
    "solid-styled": "0.12.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-solid": "2.11.14",
    "vite-plugin-solid-styled": "0.12.1"
  },
  "packageManager": "pnpm@11.8.0"
}
